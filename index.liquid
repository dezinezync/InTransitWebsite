  </div>
</section>

{%- comment -%} 4 · UNDERGROUND (dark in both appearances). Centred, as Live Activities: the header,
     then the phone in front of the map of Old Delhi. The band is always dark, so the picture is
     always the dark export. {%- endcomment %}
<section class="mt-section mt-section--dark" id="underground" aria-labelledby="underground-title">
  <div class="mt-section__inner">
    <header class="mt-header mt-header--center">
      <p class="mt-eyebrow">Underground</p>
      <h2 class="mt-header__title" id="underground-title">Still on Track When the Signal Drops</h2>
      <p class="mt-header__sub">Deep in a tunnel, most apps lose you. InTransit keeps counting the stations, and shows its best guess on the map with a dashed ring until the signal is back.</p>
    </header>
    {% render "shot.html", name: "underground-phone-dark", width: 900, height: 786, sizes: "max(min(calc(100vw - 3rem), 900px), 545px)", alt: "InTransit on iPhone during a ride on the Yellow Line at Chandni Chowk, in front of the map of Old Delhi", class: "mt-wide-shot mt-wide-shot--900" %}
