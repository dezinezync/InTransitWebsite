      </li>
      <li class="mt-promise mt-promise--blue">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="3"/><circle cx="24" cy="24" r="3"/><path d="M8 11v4a4 4 0 0 0 4 4h8a4 4 0 0 1 4 4v-2M24 21v-2"/><path d="M8 11v14"/></svg>
