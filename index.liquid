      </header>
      <div class="mt-split__media mt-shot-phone">
        {% render "shot.html", name: "journey-phone", dark: true, width: 256, height: 523, sizes: "min(16rem, calc(100vw - 3rem))", alt: "A station in InTransit, with the lifts, ramps and platform access it has" %}
