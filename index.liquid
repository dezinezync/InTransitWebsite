      </li>
      <li class="mt-promise mt-promise--teal">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="11.5"/><circle cx="16" cy="10.6" r="1.5"/><path d="M9.6 13.8 16 15.2l6.4-1.4M16 15.2v4.3m-3.4 5 3.4-5 3.4 5"/></svg>
